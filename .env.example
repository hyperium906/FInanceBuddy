# Copy to .env and fill in. Never commit .env.
# On Vercel, set the same names under Project → Settings → Environment Variables.

# Spreadsheet key from the Google Sheets URL: the long string between /d/ and /edit.
GOOGLE_SHEET_ID=

# The service-account key. Set exactly one of these two.
# Locally, point at the JSON file downloaded from Google Cloud:
GOOGLE_CREDS_PATH=./credentials.json
# On Vercel there is no such file, so paste the file's whole contents (or a
# base64 encoding of them) here instead. If both are set, this one wins.
# GOOGLE_CREDS_JSON=

# Used by Import to categorize what the rules cannot. Model names are configuration.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODEL_FAST=gemini-3.5-flash-lite

# The password in front of the whole app. Required when deployed: without it
# the Vercel deployment refuses to serve. Optional locally.
APP_PASSWORD=

# Where "today" is measured. The server runs in UTC.
APP_TIMEZONE=America/New_York

# Linked bank accounts, via SimpleFIN Bridge. Do not type this by hand: run
#   npm run simplefin:claim -- <token>
# which claims a setup token and writes the result here.
SIMPLEFIN_ACCESS_URL=
