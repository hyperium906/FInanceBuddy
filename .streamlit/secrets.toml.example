# Copy the CONTENTS of this file into your host's secrets manager.
#
# On Streamlit Community Cloud: your app -> Settings -> Secrets, paste, save.
# Locally you would normally use .env instead; if you do copy this to
# .streamlit/secrets.toml, note that file is gitignored and must stay that way.
#
# Every key here is read by finance_app/config.py.

GOOGLE_SHEET_ID = "the-long-id-between-/d/-and-/edit-in-your-sheet-url"

GEMINI_API_KEY = "your-key-from-aistudio.google.com"
GEMINI_MODEL = "gemini-2.5-pro"
GEMINI_MODEL_FAST = "gemini-2.5-flash"

# The service-account key, inline. There is no key file on a deployed host --
# it is gitignored and never leaves your laptop -- so paste the whole JSON.
# Open your downloaded key file, copy all of it, and put it between the triple
# quotes. Keep the braces. Do NOT set GOOGLE_CREDS_PATH here.
GOOGLE_CREDS_JSON = """
{
  "type": "service_account",
  "project_id": "...",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "something@your-project.iam.gserviceaccount.com",
  "client_id": "...",
  "token_uri": "https://oauth2.googleapis.com/token"
}
"""
