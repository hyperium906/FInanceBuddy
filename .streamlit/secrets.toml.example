# Copy the CONTENTS of this file into your host's secrets manager.
#
# On Streamlit Community Cloud: your app -> Settings -> Secrets, paste, save.
# Locally you would normally use .env instead; if you do copy this to
# .streamlit/secrets.toml, note that file is gitignored and must stay that way.
#
# Every key here is read by finance_app/config.py.

GOOGLE_SHEET_ID = "the-long-id-between-/d/-and-/edit-in-your-sheet-url"

GEMINI_API_KEY = "your-key-from-aistudio.google.com"
GEMINI_MODEL = "gemini-2.5-pro"
GEMINI_MODEL_FAST = "gemini-2.5-flash"

# The service-account key. There is no key file on a deployed host -- it is
# gitignored and never leaves your laptop -- so the key travels in this value.
#
# Give it BASE64, on one line. This is not a preference: the key file's
# private_key field contains literal backslash-n sequences, and TOML's
# double-quoted strings ("..." and """...""") process escapes, so pasting the
# raw JSON there silently turns each \n into a real newline and the JSON no
# longer parses. Base64 has nothing for TOML to interpret.
#
# Produce it with:
#
#     python -c "import base64,sys; print(base64.b64encode(open(sys.argv[1],'rb').read()).decode())" credentials.json
#
GOOGLE_CREDS_JSON = "eyJ0eXBlIjogInNlcnZpY2VfYWNjb3VudCIsIC4uLn0="

# If you would rather paste readable JSON, use a TOML *literal* string --
# triple SINGLE quotes -- which performs no escape processing:
#
# GOOGLE_CREDS_JSON = '''
# {
#   "type": "service_account",
#   "private_key": "-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n",
#   "client_email": "something@your-project.iam.gserviceaccount.com"
# }
# '''
#
# Triple-double quotes will NOT work. That is the whole reason base64 is the
# default above.
