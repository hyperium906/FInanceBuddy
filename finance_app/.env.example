# Copy to .env in the project root and fill in. Never commit .env.
#
# This file is for running locally. A deployed host has no .env — put the same
# values in its secrets manager instead, and see the README's Deploying
# section for the one variable that differs there.

# Spreadsheet key from the Google Sheets URL: the long string between
# /d/ and /edit.
GOOGLE_SHEET_ID=

# The service-account key. Set exactly one of these two.
#
# Locally, point at the JSON file you downloaded from Google Cloud:
GOOGLE_CREDS_PATH=./credentials.json
# Deployed, there is no such file — it is gitignored and stays on your
# machine — so paste the file's entire contents (or a base64 encoding of them)
# into this instead. If both are set, this one wins.
# GOOGLE_CREDS_JSON=

GEMINI_API_KEY=
# Model names are configuration, not code. Change them here.
GEMINI_MODEL=gemini-2.5-pro
GEMINI_MODEL_FAST=gemini-2.5-flash
